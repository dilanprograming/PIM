tk.Button(frame_inicio, text="Sou Professor", bg="green", fg="white", width=20, height=2, command=tela_login_professor).pack(pady=10)
tk.Button(frame_inicio, text="Sou Aluno", bg="white", fg="green", width=20, height=2,
